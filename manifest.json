{
  "manifest_version": 2,
  "name": "Naurok+",
  "version": "2.0",
  "description": "Naurok & Vseosvita tools.",
  "permissions": [
    "storage",
    "tabs",
    "*://*.naurok.com.ua/*",
    "*://*.naurok.ua/*",
    "*://*.na-urok.com.ua/*",
    "*://*.vseosvita.ua/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Naurok+",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.naurok.com.ua/*",
        "*://*.naurok.ua/*",
        "*://*.na-urok.com.ua/*",
        "*://*.vseosvita.ua/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "naurokplus@local",
      "strict_min_version": "109.0"
    }
  }
}
